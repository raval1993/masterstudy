[Unit]
Description=MasterStudy private AI draft worker
After=network.target masterstudy-local-ai.service

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/masterstudy/wordpress-masterstudy/tools/wp-cli.phar --path=/var/www/masterstudy eval mls_run_due_jobs();
Environment=HOME=/var/www
TimeoutStartSec=240
MemoryMax=512M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/masterstudy/wp-content
