[Unit]
Description=MasterStudy local AI
After=network-online.target
Wants=network-online.target

[Service]
User=masterstudy-ai
Group=masterstudy-ai
ExecStart=/opt/masterstudy/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11435
Environment=OLLAMA_MODELS=/opt/masterstudy/ai-models
Environment=OLLAMA_NO_CLOUD=true
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_MAX_QUEUE=2
Environment=OLLAMA_CONTEXT_LENGTH=2048
Environment=OLLAMA_KEEP_ALIVE=2m
Environment=HOME=/opt/masterstudy/ai-models
Restart=on-failure
RestartSec=5
MemoryMax=1600M
CPUQuota=150%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/masterstudy/ai-models

[Install]
WantedBy=multi-user.target
